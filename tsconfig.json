{
  "extends": "./tsconfig.base.json",

  "compilerOptions": {
    "jsx": "react-jsx", 
    "composite": true 
  },

  "include": [
    "**/*.ts",
    "**/*.tsx",
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/types/**/*.d.ts",
    "src/shared/**/*.ts",
    "src/preload/**/*.ts",
    "src/main/**/*.ts",
    "../shared/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "out",
    "**/*.test.*",
    "**/*.spec.*",
    "coverage",
    "prisma/migrations",
    "scripts",
    "debug-scripts",
    "test",
    "**/*.config.js",
    "**/*.config.mjs"
  ]
}